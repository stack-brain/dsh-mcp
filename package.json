{
  "name": "dsh-mcp",
  "version": "1.13.0",
  "description": "MCP 管理界面 + tool search：可视化配置/启停/刷新 MCP 服务器与工具勾选，按需检索（tool search）热注入；工具列表稳定命中缓存、不撑爆上下文。DeepSeek Harness plugin: MCP management UI + tool search — stable tool list, cache-friendly, no context bloat.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "static",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/cordis-plugin-include": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/cordis-plugin-include": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-timeout": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "author": "Arvin.qi <arvin.qi@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stack-brain/dsh-mcp.git"
  },
  "homepage": "https://github.com/stack-brain/dsh-mcp",
  "bugs": {
    "url": "https://github.com/stack-brain/dsh-mcp/issues"
  },
  "dsh": {
    "supported": "0.1.6-alpha.2",
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
